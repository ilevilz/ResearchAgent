# ==================== DeepSeek LLM ====================
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ==================== Semantic Scholar（可选，但强烈建议） ====================
# arXiv 超频后会封禁来源 IP，此时 S2 是唯一可靠的在线兜底源。
# 免费申请：https://www.semanticscholar.org/product/api
# 不填则 S2 大概率返回 429，检索降级为离线论文库。
SEMANTIC_SCHOLAR_API_KEY=

# ==================== Embedding ====================
# auto | hash | sentence-transformers
# auto = 优先语义模型，不可用时自动降级哈希向量（保证任何环境可运行）
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ==================== RAG ====================
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=5

# ==================== Agent ====================
MAX_STEPS=6
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# ==================== MCP ====================
# stdio（子进程，默认）| inprocess（同进程，调试用）
MCP_TRANSPORT=stdio
